{
  "name": "elbasha-hotspot",
  "version": "1.0.0",
  "private": true,
  "description": "El Basha Net — MikroTik hotspot templates, turnkey RouterOS script and voucher studio",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "switch": "node scripts/switch-theme.mjs",
